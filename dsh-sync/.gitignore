# Local-only and sensitive data. Keep these out of git.
**/node_modules/
**/.pnpm-store/
**/cache/
**/logs/
**/sessions/
**/attachments/
**/.credentials.yaml
**/.credentials.yaml.bak-*
**/*.bak-*
**/DSH Desktop/
**/*.exe
**/*.dll
**/*.pak

# Root .gitignore ignores all lib/ directories; custom plugins' lib/* source
# files are tracked.
!dsh/plugins/*/lib/
!dsh/plugins/*/lib/*
