{
  "name": "dsh-account-switcher",
  "version": "0.1.0",
  "description": "cc-switch 风格的多账号管理：管理多个 DeepSeek API Key / 模型档案，一键切换（热加载免重启）。Account manager & one-click switcher for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "account-switcher",
    "cc-switch",
    "api-key",
    "multi-account"
  ],
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
